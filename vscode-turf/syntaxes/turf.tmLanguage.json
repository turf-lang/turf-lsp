{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Turf",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.turf",
          "match": "//.*$"
        },
        {
          "name": "comment.block.turf",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.turf",
          "match": "\\b(if|else|while|for|return|break|continue|fn|import)\\b"
        },
        {
          "name": "storage.type.turf",
          "match": "\\b(int|float|string|bool|void|mut|immut|struct|extern)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.turf",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.turf",
              "match": "\\\\."
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.turf"
}
