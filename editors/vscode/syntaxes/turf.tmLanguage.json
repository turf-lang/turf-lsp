{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Turf",
  "scopeName": "source.turf",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#import" },
    { "include": "#struct-decl" },
    { "include": "#enum-decl" },
    { "include": "#function-decl" },
    { "include": "#types" },
    { "include": "#scope-access" },
    { "include": "#method-call" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.turf", "match": "///.*$" },
        { "name": "comment.line.double-slash.turf", "match": "//.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.turf",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.turf", "match": "\\\\[ntr0abfv\\\\\"']" },
        { "name": "invalid.illegal.escape.turf", "match": "\\\\." }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.turf",
          "match": "'(\\\\[ntr0abfv\\\\\"']|[^'\\\\\\n])'",
          "captures": { "1": { "name": "constant.character.escape.turf" } }
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.turf", "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b" },
        { "name": "constant.numeric.binary.turf", "match": "\\b0[bB][01][01_]*\\b" },
        { "name": "constant.numeric.octal.turf", "match": "\\b0[oO][0-7][0-7_]*\\b" },
        { "name": "constant.numeric.float.turf", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b" },
        { "name": "constant.numeric.integer.turf", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "annotations": {
      "name": "storage.modifier.annotation.turf",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.turf", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.language.self.turf", "match": "\\bself\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.turf",
          "match": "\\b(if|elseif|else|while|do|for|in|step|give|otherwise|break|continue|return|compare|matches|done|to|run|produce|recover|try|defer|as|guess)\\b"
        },
        {
          "name": "keyword.declaration.turf",
          "match": "\\b(fn|mut|mutable|immut|immutable|struct|enum|machine|extern|import|export|static|operator|pub|public|unsafe|sizeof|error|caller_location)\\b"
        },
        { "name": "keyword.operator.scope.turf", "match": "::" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.turf", "match": "\\b(int|int32|double|float|bool|char|string|ptr|void)\\b" },
        {
          "match": "(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.type.turf" },
            "2": { "name": "entity.name.type.turf" }
          }
        },
        { "name": "entity.name.type.turf", "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=<)" }
      ]
    },
    "import": {
      "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.turf" },
        "2": { "name": "entity.name.namespace.turf" }
      }
    },
    "struct-decl": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.turf" },
        "2": { "name": "entity.name.type.struct.turf" }
      }
    },
    "enum-decl": {
      "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.turf" },
        "2": { "name": "entity.name.type.enum.turf" }
      }
    },
    "function-decl": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.turf" },
            "2": { "name": "entity.name.type.struct.turf" },
            "3": { "name": "punctuation.accessor.turf" },
            "4": { "name": "entity.name.function.turf" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.declaration.turf" },
            "2": { "name": "entity.name.function.turf" }
          }
        }
      ]
    },
    "scope-access": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.namespace.turf" },
        "2": { "name": "keyword.operator.scope.turf" },
        "3": { "name": "entity.name.function.turf" }
      }
    },
    "method-call": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.turf" },
            "2": { "name": "entity.name.function.turf" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.turf" },
            "2": { "name": "variable.other.property.turf" }
          }
        }
      ]
    },
    "function-call": {
      "name": "entity.name.function.turf",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
    },
    "operators": {
      "name": "keyword.operator.turf",
      "match": "(\\*\\*=?|\\.\\.|->|=>|==|!=|<=|>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|%=|=|\\+|-|\\*|/|%|<|>|!|&|\\||\\^|~|\\?)"
    }
  }
}
